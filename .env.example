# Expent Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

API_PREFIX=api/v1
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DEFAULT_SALARY_AMOUNT=87500
DEFAULT_SALARY_DAY=10
DEFAULT_TIMEZONE=Asia/Kolkata
# Firebase Admin SDK credentials used to send push notifications via FCM.
# Provide ONE of the two: a path to the service account JSON file (good for
# local dev) or the JSON content itself as a single-line env var (good for
# deploys like Render where you can't easily ship a file).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=development
PORT=8080
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
THROTTLE_LIMIT=100
THROTTLE_TTL=60000
